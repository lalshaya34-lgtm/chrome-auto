const pageUrlInput = document.getElementById('pageUrl');
const openPageButton = document.getElementById('openPageButton');
const modeSelect = document.getElementById('mode');
const selectorInput = document.getElementById('selector');
const intervalInput = document.getElementById('interval');
const xCoordInput = document.getElementById('xCoord');
const yCoordInput = document.getElementById('yCoord');
const startButton = document.getElementById('startButton');
const stopButton = document.getElementById('stopButton');
const closeButton = document.getElementById('closeButton');
const statusText = document.getElementById('status');

function setStatus(text, color = '#93c5fd') {
  statusText.textContent = text;
  statusText.style.color = color;
}

async function callApi(path, payload = {}) {
  const response = await fetch(path, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  });

  const data = await response.json();
  if (!response.ok) {
    throw new Error(data.error || 'Request failed');
  }

  return data;
}

openPageButton.addEventListener('click', async () => {
  try {
    const url = pageUrlInput.value.trim();
    if (!url) {
      setStatus('Enter a URL first.', '#fca5a5');
      return;
    }

    setStatus('Opening page...');
    await callApi('/api/open', { url });
    setStatus('Page opened successfully.', '#22c55e');
  } catch (error) {
    setStatus(error.message, '#fca5a5');
  }
});

startButton.addEventListener('click', async () => {
  try {
    const mode = modeSelect.value;
    const interval = Number(intervalInput.value) || 1000;

    if (mode === 'selector' && !selectorInput.value.trim()) {
      setStatus('Add a CSS selector like button or .primary-button.', '#fca5a5');
      return;
    }

    const payload = {
      mode,
      selector: selectorInput.value.trim(),
      interval,
      x: Number(xCoordInput.value) || 600,
      y: Number(yCoordInput.value) || 350
    };

    await callApi('/api/start', payload);
    setStatus('Clicking started.', '#22c55e');
  } catch (error) {
    setStatus(error.message, '#fca5a5');
  }
});

stopButton.addEventListener('click', async () => {
  try {
    await callApi('/api/stop');
    setStatus('Clicking stopped.', '#cbd5e1');
  } catch (error) {
    setStatus(error.message, '#fca5a5');
  }
});

closeButton.addEventListener('click', async () => {
  try {
    await callApi('/api/close');
    setStatus('Browser closed.', '#cbd5e1');
  } catch (error) {
    setStatus(error.message, '#fca5a5');
  }
});

async function checkHealth() {
  try {
    const data = await fetch('/api/health').then((r) => r.json());
    if (data.running) {
      setStatus('Automation is running.', '#22c55e');
    }
  } catch (error) {
    console.warn('Health check failed', error);
  }
}

checkHealth();
