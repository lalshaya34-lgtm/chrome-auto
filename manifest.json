{
  "manifest_version": 3,
  "name": "Chrome Auto Clicker",
  "version": "1.0.0",
  "description": "Clicks automatically on web pages so you can use it like an auto clicker in Chrome on a Chromebook.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Chrome Auto Clicker",
    "default_popup": "popup.html"
  }
}
