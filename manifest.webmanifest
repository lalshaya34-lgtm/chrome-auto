const installButton = document.getElementById('installButton');
const openSiteButton = document.getElementById('openSiteButton');
const startButton = document.getElementById('startButton');
const stopButton = document.getElementById('stopButton');
const intervalInput = document.getElementById('interval');
const modeSelect = document.getElementById('mode');
const selectorInput = document.getElementById('selector');
const statusText = document.getElementById('status');

let deferredPrompt = null;
let running = false;
let timerId = null;

function setStatus(message, color = '#93c5fd') {
  statusText.textContent = message;
  statusText.style.color = color;
}

window.addEventListener('beforeinstallprompt', (event) => {
  event.preventDefault();
  deferredPrompt = event;
  installButton.classList.remove('hidden');
});

installButton.addEventListener('click', async () => {
  if (!deferredPrompt) {
    setStatus('Install is not available in this browser session.', '#fca5a5');
    return;
  }

  deferredPrompt.prompt();
  await deferredPrompt.userChoice;
  deferredPrompt = null;
  installButton.classList.add('hidden');
});

openSiteButton.addEventListener('click', () => {
  const url = window.prompt('Enter the website URL to open (example: https://example.com)', 'https://example.com');
  if (!url) return;

  window.open(url, '_blank', 'noopener,noreferrer');
  setStatus('Website opened in a new tab.');
});

function clickPageTarget() {
  try {
    const mode = modeSelect.value;
    const selector = selectorInput.value.trim();

    if (mode === 'selector' && selector) {
      const target = document.querySelector(selector);
      if (target) {
        target.click();
        return;
      }
      setStatus('Selector not found. Try button, .primary-button, or #start.', '#fca5a5');
      return;
    }

    const x = window.innerWidth / 2;
    const y = window.innerHeight / 2;
    const element = document.elementFromPoint(x, y);

    if (element) {
      element.click();
      return;
    }

    setStatus('No clickable target was found under the cursor.', '#fca5a5');
  } catch (error) {
    console.error(error);
    setStatus('Click failed. Check the selector or page state.', '#fca5a5');
  }
}

startButton.addEventListener('click', () => {
  if (running) {
    setStatus('Already running.', '#c4b5fd');
    return;
  }

  const interval = Number(intervalInput.value) || 1000;
  const mode = modeSelect.value;

  if (mode === 'selector' && !selectorInput.value.trim()) {
    setStatus('Add a selector such as button or .start-btn.', '#fca5a5');
    return;
  }

  running = true;
  setStatus('Running', '#22c55e');
  timerId = setInterval(clickPageTarget, interval);
});

stopButton.addEventListener('click', () => {
  if (!running) {
    setStatus('Already stopped.', '#cbd5e1');
    return;
  }

  running = false;
  clearInterval(timerId);
  timerId = null;
  setStatus('Stopped', '#cbd5e1');
});

if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./sw.js').catch(() => {
      console.warn('Service worker registration failed.');
    });
  });
}
